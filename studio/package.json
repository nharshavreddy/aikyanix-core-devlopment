{
  "name": "aikyanix-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed:build": "node seed/build.mjs",
    "seed:import": "sanity dataset import seed/content.ndjson production --replace",
    "seed:shop": "node seed/shop.mjs && sanity dataset import seed/shop.ndjson production --missing",
    "content:apply": "sanity exec seed/apply-v2.ts --with-user-token"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.23.0",
    "styled-components": "^6.6.0",
    "@sanity/icons": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
